{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enablePreCommit"
  ],
  "timezone": "Europe/Madrid",
  "schedule": ["* 7-8 * * 5"],
  "prBodyTemplate": "{{{table}}}",
  "constraints": {
    "poetry": ">=2.5.1"
  },
  "packageRules": [
    {
      "description": "Group all dependencies except python",
      "matchPackageNames": ["!python"],
      "matchDepNames": ["!python"],
      "separateMajorMinor": false,
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies"
    },
    {
      "description": "Group python version updates",
      "matchPackageNames": ["python"],
      "separateMajorMinor": false,
      "groupName": "python-updates",
      "groupSlug": "python-major-minor"
    },
    {
      "description": "Group all pre-commit updates",
      "matchManagers": ["pre-commit"],
      "matchPackageNames": ["!python"],
      "groupName": "pre-commit dependencies",
      "groupSlug": "pre-commit-dependencies"
    }
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  }
}
