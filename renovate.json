{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enablePreCommit"
  ],
  "timezone": "Europe/Madrid",
  "schedule": ["* 7-8 * * 5"],
  "prBodyTemplate": "{{{table}}}",
  "constraints": {
    "poetry": ">=2.5.1"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the Python runtime version in the Makefile",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "PYTHON_VERSION\\s*\\?=\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "python/cpython",
      "depTypeTemplate": "python-version",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group all non-major dependencies except python",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchPackageNames": ["!python", "!python/cpython", "!actions/setup-python"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Group python version updates across all files",
      "matchPackageNames": ["python", "python/cpython", "actions/setup-python"],
      "separateMajorMinor": false,
      "groupName": "python-runtime",
      "groupSlug": "python-runtime",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Group all pre-commit updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit dependencies",
      "groupSlug": "pre-commit-dependencies"
    }
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  }
}
