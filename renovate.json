{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enablePreCommit"
  ],
  "timezone": "Europe/Madrid",
  "schedule": ["* 7-8 * * 5"],
  "prBodyTemplate": "{{{table}}}",
  "constraints": {
    "poetry": ">=2.5.1"
  },

  "packageRules": [
    {
      "description": "Group all pre-commit updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit dependencies",
      "groupSlug": "pre-commit-dependencies"
    }
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  }
}
